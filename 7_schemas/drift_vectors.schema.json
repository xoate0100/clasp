{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriftVectors",
  "type": "object",
  "required": ["version", "vectors"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string"},
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "source", "detection"],
        "properties": {
          "id": {"type": "string", "pattern": "^DV_[A-Z0-9_]+$"},
          "description": {"type": "string"},
          "source": {"type": "string"},
          "detection": {"type": "string"},
          "linked_decision": {"type": "string"},
          "trigger_patterns": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
