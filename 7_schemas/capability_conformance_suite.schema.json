{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/capability_conformance_suite.schema.json",
  "title": "Capability Conformance Suite (declarative)",
  "description": "Language-neutral conformance cases. The suite is the compiler (blueprint §1.1 / DEC-CP-0005). Adapters execute cases in their language; cases themselves are not language-bound tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "version", "cases"],
  "properties": {
    "suite_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "expect"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "input": {
          "type": "object",
          "description": "Declarative fixture / stimulus (no executable code)"
        },
        "expect": {
          "type": "object",
          "required": ["outcome"],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["pass", "fail", "reject", "partial"]
            },
            "asserts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "op"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string", "description": "JSONPath-like pointer into result" },
                  "op": {
                    "type": "string",
                    "enum": ["eq", "neq", "exists", "type", "contains", "matches"]
                  },
                  "value": {}
                }
              }
            },
            "error_code": { "type": "string" }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
