        }
      },
      "conformance_suite": {
        "suite_id": "CAP-RULE-001.eval",
        "version": "1.0.0",
        "cases": [
          {
            "id": "rule-reject-presence-only",
            "input": { "claim": { "files_exist": true }, "tests_ran": false },
            "expect": { "outcome": "reject", "error_code": "PRESENCE_ONLY" }
          },
          {
            "id": "rule-accept-with-eval",
            "input": { "claim": { "files_exist": true }, "tests_ran": true, "tests_passed": true },
            "expect": { "outcome": "pass" }
