{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeSources",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string"},
    "index": {
      "type": "object",
      "properties": {
        "output_dir": {"type": "string"},
        "chunk_max_chars": {"type": "integer"},
        "chunk_overlap": {"type": "integer"},
        "backend": {"type": "string", "enum": ["bm25"]}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "priority"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "priority": {"type": "integer"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
