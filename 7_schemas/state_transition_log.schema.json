{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "State Transition Log Event",
  "description": "Schema for a single state transition event in state_transition_log.jsonl",
  "type": "object",
  "required": [
    "transition_id",
    "timestamp",
    "plan_id",
    "component",
    "from_task",
    "to_task",
    "actor"
  ],
  "properties": {
    "transition_id": {
      "type": "string",
      "description": "Unique identifier for this transition event",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO8601 timestamp with timezone",
      "format": "date-time"
    },
    "plan_id": {
      "type": "string",
      "description": "Plan ID from ACTIVE_PLAN.yaml"
    },
    "component": {
      "type": "string",
      "description": "Component name (e.g., frontend, backend, shared)"
    },
    "from_task": {
      "description": "Task ID being completed",
      "oneOf": [
        {"type": "integer"},
        {"type": "string"}
      ]
    },
    "to_task": {
      "description": "Task ID being started",
      "oneOf": [
        {"type": "integer"},
        {"type": "string"}
      ]
    },
    "actor": {
      "type": "string",
      "enum": ["cursor_ai", "human", "automation"],
      "description": "Entity that initiated the transition"
    },
    "intent_id": {
      "type": "string",
      "description": "Intent ID from INTENT_DECLARATION.json (optional)"
    },
    "completion_report_path": {
      "type": "string",
      "description": "Path to completion report artifact (optional)"
    },
    "gate_results": {
      "type": "array",
      "description": "List of gate check results",
      "items": {
        "type": "object",
        "properties": {
          "gate": {"type": "string"},
          "passed": {"type": "boolean"},
          "message": {"type": "string"}
        }
      }
    },
    "commit_hash": {
      "type": "string",
      "description": "Git commit hash if available (optional)"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about the transition"
    }
  }
}

