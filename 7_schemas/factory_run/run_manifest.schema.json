{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/factory_run/run_manifest.schema.json",
  "title": "factory-run-manifest/v1",
  "description": "Shared run manifest. §1–§6 cutrates/surewealth shapes remain valid; §7 agent-driven blog runs add optional driver/validate/agent_scored.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "target",
    "profile",
    "topic",
    "agents_file",
    "content_hash",
    "started_at",
    "finished_at",
    "outcome",
    "stages",
    "spend_usd",
    "beats",
    "artifacts",
    "review_url"
  ],
  "properties": {
    "schema": { "const": "factory-run-manifest/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "string",
      "description": "cutrates | surewealth | <business>-blog"
    },
    "profile": {
      "type": "string",
      "description": "cutrates.skill | ce.course | blog.article"
    },
    "driver": {
      "type": "string",
      "enum": ["factory_run", "agent"],
      "description": "Optional. Absent or factory_run = §1–§6; agent = §7 agent-driven run"
    },
    "topic": { "type": "string" },
    "agents_file": { "type": "string" },
    "content_hash": { "type": "string" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": ["draft_created", "dry_run", "partial", "spend_blocked"]
    },
    "stages": {
      "type": "object",
      "required": ["generate", "import"],
      "additionalProperties": false,
      "properties": {
        "generate": {
          "type": "object",
          "required": ["ran", "model_calls"],
          "properties": {
            "ran": { "enum": ["live", "fixture", "agent"] },
            "model_calls": {
              "type": "array",
              "description": "Recorded where observable; may be empty for agent runs"
            }
          }
        },
        "validate": {
          "type": "object",
          "description": "§7 agent-driven blog evaluate stage",
          "required": ["ran"],
          "properties": {
            "ran": { "enum": ["live", "fixture", "skipped"] },
            "report_path": { "type": ["string", "null"] }
          }
        },
        "narrate": {
          "type": "object",
          "required": ["ran", "characters"],
          "properties": {
            "ran": { "enum": ["live", "fixture", "skipped"] },
            "characters": { "type": "integer", "minimum": 0 }
          }
        },
        "render": {
          "type": "object",
          "required": ["ran", "clips"],
          "properties": {
            "ran": { "enum": ["live", "fixture", "skipped"] },
            "clips": { "type": "integer", "minimum": 0 }
          }
        },
        "import": {
          "type": "object",
          "required": ["ran", "idempotent_noop"],
          "properties": {
            "ran": { "enum": ["live", "skipped", "fixture"] },
            "draft_id": {},
            "idempotent_noop": { "type": "boolean" },
            "stage_ref": {
              "type": ["string", "null"],
              "description": "content.publish.stage result; draft_id mirrors this for §7"
            }
          }
        }
      }
    },
    "spend_usd": {
      "type": "object",
      "required": ["generation", "narration", "total"],
      "properties": {
        "generation": { "type": "string" },
        "narration": { "type": "string" },
        "total": { "type": "string" }
      }
    },
    "beats": { "type": "integer", "minimum": 0 },
    "artifacts": {
      "type": "object",
      "properties": {
        "content_ir": { "type": "string" },
        "clips": { "type": "array" },
        "captions": { "type": "array" },
        "compliance_report": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "agent_scored": {
      "type": "object",
      "description": "§7 judgment dimensions (e.g. d6_voice) with score + rationale; never gate alone",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "rationale"],
        "properties": {
          "score": { "type": "number" },
          "rationale": { "type": "string" }
        }
      }
    },
    "review_url": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
