{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceSpineRegistry",
  "type": "object",
  "required": ["version", "registries"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string"},
    "layer_yield_order": {"type": "array", "items": {"type": "string"}},
    "layers": {"type": "object"},
    "registries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "schema": {"type": "string"},
          "validator": {"type": "string"},
          "indexer": {"type": "string"},
          "writer": {"type": "string"},
          "append_only": {"type": "boolean"},
          "min_shape": {"type": "object"}
        }
      }
    }
  }
}
