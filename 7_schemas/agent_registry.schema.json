{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentRegistry",
  "type": "object",
  "required": ["version", "agents", "graph", "write_policy"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string"},
    "write_policy": {
      "type": "object",
      "required": ["allowed_write_globs", "forbidden_write_globs"],
      "properties": {
        "allowed_write_globs": {"type": "array", "items": {"type": "string"}},
        "forbidden_write_globs": {"type": "array", "items": {"type": "string"}},
        "rebuild_only_via": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cost_guardrails": {"type": "object"},
    "tools": {"type": "object"},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "output_model", "tools", "handoffs"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "output_model": {"type": "string"},
          "tools": {"type": "array", "items": {"type": "string"}},
          "handoffs": {"type": "array", "items": {"type": "string"}},
          "write_fragments": {"type": "boolean"}
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["start", "edges"],
      "properties": {
        "entry_gate": {"type": "string"},
        "start": {"type": "string"},
        "max_review_loops": {"type": "integer"},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "when": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
