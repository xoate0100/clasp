{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/profile.ce.course.schema.json",
  "title": "ContentIR profile extension — ce.course",
  "description": "Required profile_extension when profile=ce.course (DEC-FAC-0001, DEC-FAC-0015).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credit_hours_requested",
    "credit_hours_assigned",
    "seat_time_minutes",
    "exam_blueprint",
    "jurisdiction_bindings",
    "provider_course_numbers",
    "likely_misconceptions"
  ],
  "properties": {
    "credit_hours_requested": {
      "type": "number",
      "minimum": 0,
      "description": "Authoring request (DEC-FAC-0015)"
    },
    "credit_hours_assigned": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Post-approval assigned hours; null until approved"
    },
    "seat_time_minutes": {
      "type": "number",
      "minimum": 0
    },
    "exam_blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool_size", "items_per_attempt"],
      "properties": {
        "pool_size": { "type": "integer", "minimum": 1 },
        "items_per_attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "jurisdiction_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jurisdiction_id"],
        "properties": {
          "jurisdiction_id": { "type": "string", "minLength": 1 },
          "rule_pack_ref": { "type": "string" }
        }
      }
    },
    "provider_course_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jurisdiction_id", "number"],
        "properties": {
          "jurisdiction_id": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "minLength": 1 }
        }
      }
    },
    "likely_misconceptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "CE misconception hook for assessment generation (Wave 3.5)"
    },
    "filing_packet_inputs": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
