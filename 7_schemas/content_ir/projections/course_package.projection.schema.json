{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/projections/course_package.projection.schema.json",
  "title": "Projection target — CoursePackage subset",
  "description": "Minimal SureWealth CoursePackage projection fields for round-trip proof.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "course_code",
    "title",
    "objectives",
    "credit_hours_requested",
    "jurisdiction_id",
    "content_hash"
  ],
  "properties": {
    "course_code": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "credit_hours_requested": { "type": "number", "minimum": 0 },
    "credit_hours_assigned": { "type": ["number", "null"] },
    "jurisdiction_id": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 1 }
  }
}
