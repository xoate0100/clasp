{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/profile.cutrates.skill.schema.json",
  "title": "ContentIR profile extension — cutrates.skill",
  "description": "Required profile_extension when profile=cutrates.skill (DEC-FAC-0001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stages",
    "retrieval",
    "anti_bias",
    "likely_misconceptions",
    "field_observation",
    "job_aid",
    "mastery_ladder"
  ],
  "properties": {
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "description": "Nine-stage instructional state machine",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0, "maximum": 8 }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule"],
      "properties": {
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset_days", "representation"],
            "properties": {
              "offset_days": { "type": "integer", "minimum": 0 },
              "representation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "anti_bias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["likely_traps"],
      "properties": {
        "likely_traps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "likely_misconceptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "field_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checklist"],
      "properties": {
        "checklist": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "job_aid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learn", "do"],
      "properties": {
        "learn": { "type": "string", "minLength": 1 },
        "do": { "type": "string", "minLength": 1 }
      }
    },
    "mastery_ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "confidence_items"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence_items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
