{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/content_ir.core.schema.json",
  "title": "ContentIR core (DEC-FAC-0001)",
  "description": "Profile-agnostic ContentIR core. Profiles cutrates.skill and ce.course extend this document. Scene graph is $ref'd (DEC-FAC-0002). Grounding uses shared grounding_ref (1.5a).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "profile",
    "objectives",
    "grounding",
    "beats",
    "assessment",
    "integrity"
  ],
  "properties": {
    "ir_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver of this IR document shape"
    },
    "profile": {
      "type": "string",
      "enum": ["cutrates.skill", "ce.course"],
      "description": "Exactly one of the two ACCEPTED profiles"
    },
    "locale_default": {
      "type": "string",
      "default": "en-US",
      "description": "Default locale for beats/on-screen text (DEC-FAC-0021 seam; unused until Wave N)"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Behavioral objective statement"
          }
        }
      }
    },
    "grounding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "grounding_ref.schema.json"
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "locale": {
            "type": "string",
            "default": "en-US",
            "description": "Beat locale seam (DEC-FAC-0021)"
          },
          "objective_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "on_screen_text": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "locale": { "type": "string", "default": "en-US" }
            }
          },
          "scene_graph": {
            "$ref": "scene_graph.schema.json"
          },
          "duration_budget_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective_id", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "objective_id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "locale": { "type": "string", "default": "en-US" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash"],
      "properties": {
        "content_hash": { "type": "string", "minLength": 1 },
        "generator": { "type": "string" },
        "attestations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "profile_extension": {
      "type": "object",
      "description": "Profile-specific fields validated by the matching profile schema"
    }
  }
}
