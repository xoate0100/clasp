{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/jurisdiction_rule_pack.schema.json",
  "title": "Jurisdiction rule pack (DEC-FAC-0005, Wave 1.5a)",
  "description": "Each rule ALLOfs the shared grounding_ref shape plus a required value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jurisdiction_id", "rules"],
  "properties": {
    "jurisdiction_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "grounding_ref.schema.json" },
          {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": {
                "description": "Rule payload (statute text / structured rule)",
                "type": ["string", "number", "boolean", "object", "array"]
              },
              "source_citation": {
                "type": "string",
                "description": "Alias accepted alongside citation from grounding_ref"
              }
            }
          }
        ]
      }
    }
  }
}
