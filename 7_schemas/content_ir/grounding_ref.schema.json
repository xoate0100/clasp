{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/grounding_ref.schema.json",
  "title": "Grounding / citation reference (Wave 1.5a shared shape)",
  "description": "Shared retrieve→cite→checksum→expire shape used by ContentIR grounding[] and jurisdiction rule-pack rules. Do not fork this shape (NEXT_STEPS 1.5a).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "citation",
    "checksum",
    "retrieved_at",
    "confidence",
    "verified_until"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "URI, drive path, statute id, or other retrieval key"
    },
    "citation": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable citation / source_citation"
    },
    "source_citation": {
      "type": "string",
      "minLength": 1,
      "description": "Alias for citation (DEC-FAC-0005 wording)"
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "description": "Content integrity checksum of the retrieved payload"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this artifact was retrieved"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Retriever/author confidence in [0,1]"
    },
    "verified_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Optional human verification timestamp"
    },
    "verified_until": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry / staleness bound (DEC-FAC-0005 / 0019)"
    },
    "verified_by": {
      "type": ["string", "null"],
      "description": "Optional verifier identity"
    },
    "excerpt_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Optional pointers into the source body"
    },
    "value": {
      "description": "Optional payload (rule text or excerpt); required on jurisdiction rules",
      "type": ["string", "number", "boolean", "object", "array", "null"]
    }
  }
}
