{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/scene_graph.schema.json",
  "title": "Scene graph (DEC-FAC-0002)",
  "description": "Renderer-agnostic scene graph per beat. No Chromium/ffmpeg-specific fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["shots"],
  "properties": {
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "duration_budget_seconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "duration_budget_seconds": { "type": "number", "minimum": 0 },
          "on_screen_text": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "locale": { "type": "string", "default": "en-US" }
            }
          },
          "spoken": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "locale": { "type": "string", "default": "en-US" },
                "ssml_hints": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "emphasis": { "type": "string" },
                    "pause_ms": { "type": "integer", "minimum": 0 },
                    "prosody": { "type": "string" }
                  }
                }
              }
            }
          },
          "media_slots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role"],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["broll", "still", "diagram", "job_aid", "other"]
                },
                "query": { "type": "string" },
                "provenance": { "type": "string" }
              }
            }
          },
          "transition": {
            "type": "string",
            "description": "Logical transition label (not encoder-specific)"
          }
        }
      }
    },
    "total_duration_budget_seconds": {
      "type": "number",
      "minimum": 0
    }
  }
}
